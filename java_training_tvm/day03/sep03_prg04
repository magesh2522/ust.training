public class prg04 {
public static void main(String[]args) {
	String name="abcdefghijklmnopqrstuvwxyz";
	System.out.println(name.length());
	System.out.println(name.toUpperCase());//making upperCase
	System.out.println(name.toLowerCase());//making LowerCase
	//finding index
	String name1="hi how are i hope your doing great ,keep it and roxk it";
	System.out.println(name1.indexOf("great"));
	
	String name2="Magesh";
	String name3="Kubendran";
